{
  "name": "@clevertask/kanban-board-ui",
  "version": "0.0.14",
  "homepage": "https://github.com/clevertask/kanban-board-ui#readme",
  "bugs": {
    "url": "https://github.com/clevertask/kanban-board-ui/issues"
  },
  "license": "MIT",
  "author": "CleverTask",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clevertask/kanban-board-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/kanban-board-ui.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/kanban-board-ui.js"
    },
    "./e2e": {
      "types": "./dist/e2e/utils/index.d.ts",
      "default": "./dist/e2e/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "e2e": "pnpm run e2e:prepare && playwright test && pnpm run e2e:build-consumer",
    "e2e:build-consumer": "pnpm --dir e2e/consumer exec vite build",
    "e2e:dev": "pnpm run e2e:prepare && playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:prepare": "pnpm run build && node scripts/prepare-package-consumer.mjs",
    "e2e:serve": "pnpm --dir e2e/consumer exec vite --force --strictPort --host 127.0.0.1 --port 5174",
    "build": "rm -rf dist && vite build && vite build -c vite.test.config.ts && tsc -p tsconfig.types.json --noCheck",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "validate:deps": "pnpm run fmt:check && pnpm run lint && pnpm run e2e:install && pnpm run e2e"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@radix-ui/react-icons": "^1.3.2",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "react": ">=18.3.1 <20.0.0",
    "react-dom": ">=18.3.1 <20.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
